{
    "name": "misakstvanu/laravel-fortify-passkeys",
    "description": "Passkeys backend implementation for Laravel Fortify",
    "type": "library",
    "require": {
        "php": "^8.2||^8.3||^8.4",
        "laravel/framework": "^10.0||^11.0",
        "web-auth/webauthn-lib": "^5.3",
        "laravel/fortify": "^1.20",
        "symfony/serializer": "^7.2",
        "symfony/property-access": "^7.2",
        "nyholm/psr7": "^1.8",
        "symfony/psr-http-message-bridge": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "orchestra/testbench": "^8.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Misakstvanu\\LaravelFortifyPasskeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misakstvanu\\LaravelFortifyPasskeys\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
              "Misakstvanu\\LaravelFortifyPasskeys\\PasskeysServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
